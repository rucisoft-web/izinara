<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_permit_license_list" model="ir.ui.view">
        <field name="name">izinara.license.list</field>
        <field name="model">izinara.license</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"
                  decoration-muted="state == 'revoked'">
                <field name="name"/>
                <field name="type_id"/>
                <field name="party_id"/>
                <field name="partner_id" optional="show"/>
                <field name="product_tmpl_ids" widget="many2many_tags" optional="show"/>
                <field name="shipment_id" optional="hide"/>
                <field name="date_issue"/>
                <field name="date_expiry"/>
                <field name="days_to_expiry" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'valid'"
                       decoration-warning="state == 'expiring'" decoration-danger="state == 'expired'"/>
            </list>
        </field>
    </record>
    <record id="view_permit_license_form" model="ir.ui.view">
        <field name="name">izinara.license.form</field>
        <field name="model">izinara.license</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_revoke" type="object" string="Cabut" invisible="state == 'revoked'"
                            groups="izinara.group_permit_manager"
                            confirm="Tandai izin ini dicabut/tidak berlaku?"/>
                    <field name="state" widget="statusbar" statusbar_visible="valid,expiring,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="type_id"/>
                            <field name="scope"/>
                            <field name="party_id"/>
                            <field name="partner_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_issue"/>
                            <field name="date_expiry"/>
                            <field name="days_to_expiry"/>
                            <field name="quota"/>
                            <field name="shipment_id"/>
                            <field name="application_id"/>
                        </group>
                    </group>
                    <group string="Item code">
                        <field name="product_tmpl_ids" widget="many2many_tags" nolabel="1" colspan="2"/>
                    </group>
                    <field name="note" placeholder="Catatan, mis. syarat khusus atau pelabuhan yang diizinkan"/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_permit_license_search" model="ir.ui.view">
        <field name="name">izinara.license.search</field>
        <field name="model">izinara.license</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="type_id"/>
                <field name="partner_id"/>
                <field name="product_tmpl_ids" string="Item code"/>
                <filter name="valid" string="Berlaku" domain="[('state', 'in', ('valid', 'expiring'))]"/>
                <filter name="expiring" string="Segera habis" domain="[('state', '=', 'expiring')]"/>
                <filter name="expired" string="Kedaluwarsa" domain="[('state', '=', 'expired')]"/>
                <group>
                    <filter name="group_type" string="Jenis izin" context="{'group_by': 'type_id'}"/>
                    <filter name="group_party" string="Bagian" context="{'group_by': 'party_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="view_permit_license_calendar" model="ir.ui.view">
        <field name="name">izinara.license.calendar</field>
        <field name="model">izinara.license</field>
        <field name="arch" type="xml">
            <calendar date_start="date_expiry" color="type_id" mode="month" quick_create="0">
                <field name="name"/>
                <field name="type_id"/>
            </calendar>
        </field>
    </record>
    <record id="action_permit_license" model="ir.actions.act_window">
        <field name="name">Register izin &amp; sertifikat</field>
        <field name="res_model">izinara.license</field>
        <field name="view_mode">list,form,calendar</field>
        <field name="context">{'search_default_valid': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Belum ada izin terdaftar</p>
            <p>Izin terisi otomatis saat pengurusan ditandai terbit. Izin lama (NIB, NKV, NIE ML, SHLN) bisa diinput
               langsung di sini.</p>
        </field>
    </record>
</odoo>
