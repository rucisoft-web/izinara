<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_permit_license_expiry" model="ir.cron">
        <field name="name">Izin impor: cek masa berlaku izin</field>
        <field name="model_id" ref="model_izinara_license"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_expiry()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
    <record id="cron_permit_shipment_eta" model="ir.cron">
        <field name="name">Izin impor: ingatkan izin belum lengkap menjelang ETA</field>
        <field name="model_id" ref="model_izinara_shipment"/>
        <field name="state">code</field>
        <field name="code">model._cron_check_eta()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
