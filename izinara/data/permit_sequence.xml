<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_permit_application" model="ir.sequence">
        <field name="name">Pengurusan izin impor</field>
        <field name="code">izinara.application</field>
        <field name="prefix">IZN/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_permit_shipment" model="ir.sequence">
        <field name="name">Pengapalan impor</field>
        <field name="code">izinara.shipment</field>
        <field name="prefix">IMP/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
    <record id="seq_permit_memo" model="ir.sequence">
        <field name="name">Memo antar bagian</field>
        <field name="code">izinara.memo</field>
        <field name="prefix">MEMO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
